# ============================================================
# SceneGen 后端环境变量样例
# 复制为 .env 并填入真实值。从剧本到生成最终视频需要配置以下项。
# ============================================================

# -------------------- 数据库 / 缓存 --------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scenegen
REDIS_URL=redis://localhost:6379/0

# -------------------- 安全 --------------------
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -------------------- 智谱 AI（核心：剧本解析 + 文生图 + 图生视频）--------------------
# 一个智谱 API Key 同时驱动三个能力：GLM 剧本解析 / CogView 文生图 / CogVideoX 图生视频
# 申请：https://open.bigmodel.cn/  → 控制台 → API Keys
LLM_PROVIDER=zhipu
LLM_API_KEY=your_zhipu_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 模型名（默认值通常无需改；cogview-3-flash 免费，cogvideox 视频按量计费）
LLM_MODEL=glm-4-flash

# -------------------- 积分（联调时可关闭扣费）--------------------
# CREDITS_ENABLED=False 时所有生成不扣积分，方便反复测试
CREDITS_ENABLED=False
CREDITS_INITIAL_BALANCE=10000

# -------------------- 可选：其他厂商（当前未启用）--------------------
# SD_API_URL=http://localhost:7860
# KLING_API_KEY=
# RUNWAY_API_KEY=
