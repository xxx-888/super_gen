# ============================================================
# SceneGen 后端环境变量样例
# 复制为 .env 并填入真实值。从剧本到生成最终视频需要配置以下项。
# ============================================================

# -------------------- 数据库 / 缓存 --------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scenegen
REDIS_URL=redis://localhost:6379/0

# -------------------- 安全 --------------------
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -------------------- 智谱 AI（核心：剧本解析 + 文生图 + 图生视频）--------------------
# 一个智谱 API Key 同时驱动三个能力：GLM 剧本解析 / CogView 文生图 / CogVideoX 图生视频
# 申请：https://open.bigmodel.cn/  → 控制台 → API Keys
LLM_PROVIDER=zhipu
LLM_API_KEY=your_zhipu_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 模型名（默认值通常无需改；cogview-3-flash 免费，cogvideox 视频按量计费）
LLM_MODEL=glm-4-flash

# -------------------- 积分（联调时可关闭扣费）--------------------
# CREDITS_ENABLED=False 时所有生成不扣积分，方便反复测试
CREDITS_ENABLED=False
CREDITS_INITIAL_BALANCE=10000

# -------------------- 独立文件服务器（可选）--------------------
# 配置后视频/音频上传自动转传拿公网直链，供 MiniMax 等渠道的
# reference_video / reference_audio 直接下载；也可不配 .env，
# 在后台「系统设置」里填写（DB 配置优先于本文件）
FILE_SERVER_URL=
FILE_SERVER_API_KEY=

# -------------------- 阿里云短信（注册/忘记密码手机验证码）--------------------
# RAM 子账号授权 AliyunDysmsFullAccess，签名/模板在短信控制台申请；
# 模板变量名固定为 ${code}。不配置时发送验证码返回「短信服务未配置」明确提示
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE_REGISTER=      # 注册验证码模板 (SMS_XXXXXXXX)
ALIYUN_SMS_TEMPLATE_CODE_RESET=         # 忘记密码验证码模板 (SMS_XXXXXXXX)
# SMS_CODE_EXPIRE_SECONDS=300           # 验证码有效期(秒)
# SMS_SEND_COOLDOWN_SECONDS=60          # 同手机号同用途重发冷却(秒)
# SMS_DAILY_LIMIT=10                    # 同手机号每日发送上限

# -------------------- 默认管理员（首次启动自动创建，务必改密）--------------------
ADMIN_DEFAULT_EMAIL=admin@scenegen.com
ADMIN_DEFAULT_PASSWORD=Admin123456

# -------------------- 可选：其他厂商（当前未启用）--------------------
# SD_API_URL=http://localhost:7860
# KLING_API_KEY=
# RUNWAY_API_KEY=
