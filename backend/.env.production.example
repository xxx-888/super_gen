# ============================================================
# SceneGen 生产环境配置样例
# 复制为 /opt/super_gen/backend/.env 并填入真实值（chmod 600，勿提交）
# 与开发样例 (.env.example) 的差异: 生产开关 / CORS 收紧 / 本机回环地址
# ============================================================

# -------------------- 生产开关 --------------------
ENVIRONMENT=production
DEBUG=False

# -------------------- 数据库 / 缓存（仅本机监听） --------------------
# 密码用 openssl rand -hex 16 生成；与建库时保持一致
DATABASE_URL=postgresql+asyncpg://scenegen:你的数据库密码@127.0.0.1:5432/scenegen
REDIS_URL=redis://127.0.0.1:6379/0

# -------------------- 安全 --------------------
# JWT 签名密钥，openssl rand -hex 32 生成，≥32 字符
SECRET_KEY=change-me-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS 白名单（JSON 数组格式，收紧到实际域名）
CORS_ORIGINS=["https://你的域名"]

# -------------------- 积分 --------------------
CREDITS_ENABLED=True
CREDITS_INITIAL_BALANCE=10000

# -------------------- 独立文件服务器 --------------------
# 与 sg-fileserver 服务里的 FILE_SERVER_API_KEY 保持一致；
# URL 为其对外公网地址（nginx /fs/ 反代路径）
FILE_SERVER_URL=https://你的域名/fs
FILE_SERVER_API_KEY=sk-和-fileserver-一致

# -------------------- 默认管理员（首启自动创建，登录后改密） --------------------
ADMIN_DEFAULT_EMAIL=admin@scenegen.com
ADMIN_DEFAULT_PASSWORD=改成强密码

# -------------------- 智谱 LLM（剧本解析） --------------------
# 也可留空，部署后到后台「配置模型」里填各渠道 endpoint/API Key（DB 优先）
LLM_PROVIDER=zhipu
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
